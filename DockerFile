FROM node:18-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci  # Uses the exact lockfile versions
COPY . .

# Run the linter - the build will FAIL if linting fails
RUN npm run lint 

# Run tests (optional)
# RUN CI=true npm test

# Create the production build artifact
RUN npm run build

# Stage 2: Production Environment
FROM nginx:stable-alpine
# Copy the "artifact" from the builder stage
COPY --from=builder /app/build /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]